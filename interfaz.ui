   <string notr="true">QMainWindow, QWidget {
    background-color: #ffffff;
    color: #000000;
}

QPushButton {
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 4px 8px;
    background-color: #ffffff;
    color: #000000;
}

QPushButton:hover {
    background-color: #f0f0f0;
}

QPushButton:pressed {
    background-color: #e0e0e0;
}

QLineEdit, QComboBox, QSpinBox {
    border: 1px solid #333333;
    border-radius: 3px;
    padding: 2px 4px;
    background-color: #ffffff;
    color: #000000;
}

QTabWidget::pane {
    border: 1px solid #333333;
}

QTabBar::tab {
    background-color: #d8d8d8;
    color: #000000;
    border: 1px solid #333333;
    border-bottom: none;
    padding: 6px 12px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #000000;
    font-weight: bold;
}

QTabBar::tab:!selected:hover {
    background-color: #e8e8e8;
}

QGroupBox {
    border: 1px solid #333333;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 8px;
    color: #000000;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: #000000;
}</string>
